<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Built outside Unity: `./build.sh <OmniDebugger path>` compiles this project and copies the DLL to
    the package's Runtime/Analyzers, where Unity picks it up as a Roslyn analyzer (label RoslynAnalyzer).
    Microsoft.CodeAnalysis is pinned to 4.3.1, the compiler Unity 6000.0 ships with.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <RootNamespace>DTech.OmniDebugger.SourceGenerator</RootNamespace>
    <!-- Bump on every change to the generator; stamped into the DLL and into [GeneratedCode] of its output. -->
    <Version>2.2.0</Version>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.1" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
